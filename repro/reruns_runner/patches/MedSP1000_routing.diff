+# --- PATCH (model routing only) -------------------------------------------------------------
+# A model string "<backend>:<model id>[@<temperature>]" is routed to an OpenAI-compatible endpoint:
+#   groq   -> https://api.groq.com/openai/v1  (key from env GROQ_API_KEY)
+#   ollama -> http://localhost:11434/v1       (no key)
+# Optional env MEDSP_CALL_LOG=<jsonl path>: every request/response/usage is appended there.
+_ROUTES = {
+    "groq": ("https://api.groq.com/openai/v1", "GROQ_API_KEY"),
+    "ollama": ("http://localhost:11434/v1", None),
+}
+
+
+def _parse_route(model: str | None):
+    if not model or ":" not in model:
+        return None
+    backend, rest = model.split(":", 1)
+    if backend not in _ROUTES:
+        return None
+    temp = None
+    if "@" in rest:
+        rest, t = rest.rsplit("@", 1)
+        temp = float(t)
+    return backend, rest, temp
+
+
