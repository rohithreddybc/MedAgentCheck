+
+    def _routed_client(self, backend: str):
+        if backend not in self._routed_clients:
+            from openai import OpenAI  # type: ignore
+            base, key_env = _ROUTES[backend]
+            self._routed_clients[backend] = OpenAI(
+                base_url=base,
+                api_key=os.environ[key_env] if key_env else "ollama",
+                timeout=self._timeout,
+                max_retries=8,
+            )
+        return self._routed_clients[backend]
 
